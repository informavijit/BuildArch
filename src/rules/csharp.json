{
  "language": "csharp",
  "extensions": [".cs", ".vb", ".fs", ".razor"],
  "rules": [
    {
      "id": "cs-namespace",
      "kind": "declaration",
      "pattern": "^\\s*namespace\\s+([a-zA-Z0-9_.]+)",
      "captureGroups": { "name": 1, "type": "namespace" },
      "confidence": "Extracted"
    },
    {
      "id": "cs-using",
      "kind": "import",
      "pattern": "^\\s*using\\s+(?:static\\s+)?([a-zA-Z0-9_.]+)\\s*;",
      "captureGroups": { "name": 1 },
      "confidence": "Extracted"
    },
    {
      "id": "cs-class",
      "kind": "declaration",
      "pattern": "\\b(public|internal|protected|private)?\\s*(?:static\\s+)?(?:partial\\s+)?(class|interface|struct|record)\\s+([a-zA-Z0-9_]+)",
      "captureGroups": { "name": 3, "type": 2 },
      "confidence": "Extracted"
    },
    {
      "id": "aspnet-route",
      "kind": "route",
      "pattern": "\\[(HttpGet|HttpPost|HttpPut|HttpDelete|HttpPatch|Route)\\s*(?:\\(([^)]+)\\))?\\]",
      "captureGroups": { "name": 2, "method": 1 },
      "confidence": "Extracted"
    },
    {
      "id": "aspnet-minimal-api",
      "kind": "route",
      "pattern": "app\\.(MapGet|MapPost|MapPut|MapDelete|MapGroup)\\s*\\(\\s*[\"']([^\"']+)[\"']",
      "captureGroups": { "name": 2, "method": 1 },
      "confidence": "Extracted"
    },
    {
      "id": "ef-dbcontext",
      "kind": "data",
      "pattern": "public\\s+DbSet<([a-zA-Z0-9_]+)>\\s+([a-zA-Z0-9_]+)",
      "captureGroups": { "name": 1, "type": "DbSet" },
      "confidence": "Extracted"
    },
    {
      "id": "cs-pinvoke",
      "kind": "external",
      "pattern": "\\[DllImport\\s*\\(\\s*\"([^\"]+)\"",
      "captureGroups": { "name": 1, "type": "DllImport" },
      "confidence": "Extracted"
    },
    {
      "id": "cs-main",
      "kind": "entry",
      "pattern": "static\\s+(?:async\\s+)?(?:void|int|Task)\\s+Main\\s*\\(",
      "captureGroups": { "name": "Main" },
      "confidence": "Extracted"
    }
  ]
}
